{
  "name": "clash-parser-user-rules",
  "version": "1.0.0",
  "description": "Clash Parser 用户自定义规则配置目录",
  "scripts": {
    "build:auto": "cd .. && npm run build:cvr:auto -- --user-rules ./user-rules.ts",
